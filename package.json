{
  "name": "dailytask-monorepo",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/mobile",
    "apps/desktop",
    "packages/shared"
  ],
  "scripts": {
    "api": "npm run dev --workspace=apps/api",
    "web": "npm run dev --workspace=apps/web",
    "mobile": "npm run start --workspace=apps/mobile",
    "desktop": "npm run start --workspace=@dailytask/desktop",
    "desktop:dev": "concurrently -k \"npm run web\" \"npm run start --workspace=@dailytask/desktop\"",
    "desktop:preview": "npm run preview --workspace=@dailytask/desktop",
    "desktop:dist": "npm run dist --workspace=@dailytask/desktop",
    "dev": "concurrently \"npm run api\" \"npm run web\"",
    "install:all": "npm install && cd apps/mobile && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
