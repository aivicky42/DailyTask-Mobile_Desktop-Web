{
  "name": "dailytask-monorepo",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/mobile",
    "packages/shared"
  ],
  "scripts": {
    "api": "npm run dev --workspace=apps/api",
    "web": "npm run dev --workspace=apps/web",
    "mobile": "npm run start --workspace=apps/mobile",
    "dev": "concurrently \"npm run api\" \"npm run web\"",
    "install:all": "npm install && cd apps/mobile && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
